# ==========================================
# Primo Art Gallery Proxy & Auth Server
# Environment Configuration
# ==========================================

PORT=4000
CORS_ORIGIN=*

# WooCommerce REST API Credentials
WOOCOMMERCE_URL=https://primoartgallery.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here

# Resend Email Delivery API (For 6-Digit Email OTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Primo Art Gallery <auth@primoartgallery.com>

# Server-Side OTP Secret Salt (For SHA-256 Hashing)
OTP_SECRET_SALT=primo_gallery_secure_otp_salt_random_secret_string

# Firebase Admin SDK Configuration (Server-Side Identity Authority)
# Either place serviceAccountKey.json in the server/ directory OR configure these env variables:
FIREBASE_PROJECT_ID=primo-art-gallery
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@primo-art-gallery.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
