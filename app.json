{
  "expo": {
    "name": "Primo Art Gallery",
    "slug": "primo-art-gallery",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/primo-app-icon.png",

    "scheme": "primoartgallery",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/primo-icon-foreground.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.primoartgallery.app"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/primo-splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6F1"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "updates": {
      "url": "https://u.expo.dev/417c6cd9-2c09-4d5a-b114-2278a7266596"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },

    "extra": {
      "eas": {
        "projectId": "417c6cd9-2c09-4d5a-b114-2278a7266596"
      }
    }
  }
}