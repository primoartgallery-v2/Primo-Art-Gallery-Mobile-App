rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authenticated collectors can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Collector sub-collections: wishlist, recently_viewed, saved_artists
      match /collector_data/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Artwork enquiries: Block direct client creation, reading, modification, and deletion.
    // Written exclusively via Render backend proxy using Firebase Admin SDK.
    match /artworks_enquiries/{enquiryId} {
      allow read, write: if false;
    }

    // Exhibition VIP RSVPs: Block direct client creation, reading, modification, and deletion.
    // Written exclusively via Render backend proxy using Firebase Admin SDK.
    match /exhibitions_rsvps/{rsvpId} {
      allow read, write: if false;
    }

    // Auction VIP Bids: Block direct client creation, reading, modification, and deletion.
    // Written exclusively via Render backend proxy using Firebase Admin SDK.
    match /auctions_bids/{bidId} {
      allow read, write: if false;
    }

    // OTP verification sessions: Block direct client access.
    // Managed exclusively by Render backend proxy using Firebase Admin SDK.
    match /otp_sessions/{sessionId} {
      allow read, write: if false;
    }

    // OTP rate limits: Block direct client access.
    match /otp_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Default deny-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
